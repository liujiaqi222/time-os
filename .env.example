# Neon injects this automatically when deployed through the Vercel integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use a different database or Neon branch for destructive integration tests.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/time_os_test

# Better Auth signs the web session and ChatGPT OAuth tokens with this secret.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public origin only (no /api/auth suffix). Production must use HTTPS.
# Vercel deployments infer this from VERCEL_PROJECT_PRODUCTION_URL when omitted.
BETTER_AUTH_URL=http://localhost:3000

# This is the only value intentionally exposed to browser JavaScript.
NEXT_PUBLIC_APP_NAME=Time OS
