# Neon injects this automatically when deployed through the Vercel integration.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Use a different database or Neon branch for destructive integration tests.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/time_os_test

# Server-only secrets. Generate long, unique values for every deployment.
TIMEOS_WEB_PASSWORD=replace-with-a-long-password
TIMEOS_MCP_TOKEN=replace-with-a-random-token-at-least-32-characters
TIMEOS_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# This is the only value intentionally exposed to browser JavaScript.
NEXT_PUBLIC_APP_NAME=Time OS
